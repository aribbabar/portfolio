---
import TerminalWindow from './TerminalWindow.astro';
import PixelIcon from './PixelIcon.astro';

const hireLines = [
	'Checking qualifications...',
	'Overqualified.',
	'Checking attitude...',
	"Slightly sarcastic. I'll allow it.",
	'Checking vibe...',
	'<span class="ok-text">[ok]</span> Vibe check passed.',
	'Interactive session ready.',
	'<span class="dim">Type help, ls, cd projects, cat contact/github.url, or easter-egg.</span>',
];
---

<section id="contact" class="hire-panel" aria-label="Interactive terminal and contact links">
	<TerminalWindow title="Easter_Egg.exe" command="sudo hire-me" lines={hireLines} wide interactive />
	<div class="terminal-contact" aria-label="Get in touch">
		<span>Get in touch</span>
		<a href="https://www.linkedin.com/in/aribfarooqui/" target="_blank" rel="noreferrer">
			LinkedIn <PixelIcon src="/pixelarticons/external-link.svg" />
		</a>
		<a href="https://github.com/aribbabar" target="_blank" rel="noreferrer">
			GitHub <PixelIcon src="/pixelarticons/external-link.svg" />
		</a>
	</div>
</section>

<style>
	.hire-panel {
		grid-column: 1 / -1;
		min-width: 0;
	}

	.hire-panel :global(.terminal-body) {
		height: 400px;
	}

	.terminal-contact {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 20px;
		padding: 16px 10px 2px;
		color: var(--muted);
		font-size: 12px;
	}

	.terminal-contact > span {
		margin-right: auto;
		text-transform: uppercase;
	}

	.terminal-contact a {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--green);
		text-underline-offset: 4px;
	}

	.terminal-contact :global(.pixel-icon) {
		--pixel-icon-size: 14px;
	}

	@media (max-width: 1180px) {
		.hire-panel {
			grid-column: auto;
			grid-row: auto;
		}
	}

	@media (max-width: 640px) {
		.hire-panel :global(.terminal-body) {
			height: 460px;
		}
	}
</style>
