---
import DashGlow from './DashGlow.astro';

const notes = [
	{
		context: 'Admin at ASI',
		title: 'Customer service has no sandbox',
		body: 'I learned to listen, explain what happens next, and keep coworkers in the loop. The tutorial was live.',
	},
	{
		context: 'Juggling projects',
		title: 'One brain, several tabs',
		body: 'I use LLMs to sketch approaches and get back up to speed when I switch projects. The open tabs still outnumber me.',
	},
	{
		context: 'Working with LLMs',
		title: 'Keep a hand on the wheel',
		body: 'Giving an LLM too much control taught me to set the scope and check the diff. “It said it worked” is not a test plan.',
	},
	{
		context: 'Automation',
		title: 'Automate the boring parts',
		body: 'I’ve automated a lot of the repetitive admin work. So far, the scripts haven’t asked for my chair.',
	},
];
---

<aside class="field-notes" aria-labelledby="field-notes-title">
	<h3 id="field-notes-title"><span aria-hidden="true">&gt;</span> Field Notes</h3>
	<ol class="notes" role="list">
		{notes.map((note, index) => (
			<li>
				<DashGlow edge="top" />
				<span class="note-number" aria-hidden="true">0{index + 1}</span>
				<div>
					<p class="note-context">{note.context}</p>
					<h4>{note.title}</h4>
					<p class="note-body">{note.body}</p>
				</div>
			</li>
		))}
	</ol>
</aside>

<style>
	.field-notes {
		display: flex;
		flex-direction: column;
		width: 100%;
		max-width: 420px;
		align-self: stretch;
		justify-self: center;
		padding: clamp(14px, 1.4vw, 22px);
		border: 1px solid rgba(148, 183, 220, 0.24);
		border-radius: 5px;
		background: linear-gradient(150deg, #101c2b, #080f1a 70%);
	}

	h3 {
		margin: 0;
		color: var(--purple);
		font-size: var(--experience-eyebrow-size);
		text-transform: uppercase;
	}

	.notes {
		display: grid;
		flex: 1;
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
	}

	.notes li {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-content: center;
		gap: 12px;
		padding-block: clamp(12px, 1.4vw, 20px);
		border-top: 1px dashed rgba(148, 183, 220, 0.26);
	}

	.note-number,
	.note-context {
		margin: 0;
		font-size: var(--experience-label-size);
		line-height: 1.4;
	}

	.note-number {
		color: var(--cyan);
	}

	.note-context {
		color: var(--muted);
		text-transform: uppercase;
	}

	h4 {
		margin: 3px 0 4px;
		color: #e7f1fc;
		font-size: var(--experience-heading-size);
		line-height: 1.3;
	}

	.note-body {
		margin: 0;
		color: #c6d3e0;
		font-size: var(--experience-copy-size);
		line-height: 1.55;
	}

	@media (max-width: 1120px) {
		.field-notes { justify-self: start; }
		.notes li:last-child { padding-bottom: 0; }
	}
</style>
