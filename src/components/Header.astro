---
import PixelIcon from './PixelIcon.astro';

const terminalIcon = '/pixelarticons/terminal.svg';

const links = [
	{ label: 'Home', href: '#home' },
	{ label: 'Projects', href: '#projects' },
	{ label: 'Skills', href: '#skills' },
	{ label: 'Education', href: '#education' },
	{ label: 'Experience', href: '#experience' },
];
---

<header class="shell-header">
	<a class="brand" href="#home" aria-label="Arib Farooqui home">&gt; AF.PORTFOLIO</a>
	<nav aria-label="Primary navigation">
		{
			links.map((link, index) => (
				<a href={link.href} aria-current={index === 0 ? 'location' : undefined}>
					[{String(index + 1).padStart(2, '0')}] {link.label}
				</a>
			))
		}
	</nav>
	<a class="prompt-button" href="#contact" aria-label="Open terminal">
		<PixelIcon src={terminalIcon} />
	</a>
</header>

<script>
	const entries = [...document.querySelectorAll<HTMLAnchorElement>('.shell-header nav a, .shell-header .prompt-button')]
		.map((link) => ({ link, section: document.querySelector<HTMLElement>(link.hash) }))
		.filter((entry) => entry.section !== null);
	let activeHref = '';
	let navigationFrame = 0;

	const updateNavigation = () => {
		navigationFrame = 0;
		let current = entries[0];
		for (const entry of entries) {
			if (entry.section!.getBoundingClientRect().top <= window.innerHeight * 0.3) current = entry;
		}
		if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4) {
			current = entries.at(-1) ?? current;
		}
		if (!current || current.link.hash === activeHref) return;
		activeHref = current.link.hash;
		for (const { link } of entries) {
			if (link === current.link) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		}
	};
	const scheduleNavigation = () => {
		if (!navigationFrame) navigationFrame = requestAnimationFrame(updateNavigation);
	};
	window.addEventListener('scroll', scheduleNavigation, { passive: true });
	window.addEventListener('resize', scheduleNavigation);
	window.addEventListener('hashchange', scheduleNavigation);
	window.addEventListener('load', scheduleNavigation, { once: true });
	updateNavigation();
</script>

<style>
	.shell-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 20px;
		min-width: 0;
		padding: 0 var(--section-gutter);
		border-bottom: 1px solid rgba(148, 183, 220, 0.18);
		background: linear-gradient(180deg, rgba(5, 12, 23, 0.92), rgba(3, 9, 18, 0.72));
	}

	a {
		text-decoration: none;
	}

	.brand {
		justify-self: start;
		color: var(--green);
		font-weight: 800;
		font-size: clamp(0.78rem, 0.9vw, 0.95rem);
		text-transform: uppercase;
	}

	nav {
		display: flex;
		justify-content: center;
		gap: clamp(18px, 3.6vw, 60px);
		min-width: 0;
	}

	nav a {
		flex: none;
		color: var(--text);
		font-size: clamp(0.62rem, 0.68vw, 0.76rem);
		text-transform: uppercase;
		white-space: nowrap;
		transition:
			color 160ms ease,
			text-shadow 160ms ease;
	}

	nav a:hover,
	nav a:focus-visible {
		color: var(--green);
		text-shadow: 0 0 18px rgba(94, 255, 181, 0.45);
	}

	.prompt-button {
		justify-self: end;
		display: grid;
		place-items: center;
		width: 40px;
		aspect-ratio: 1;
		border: 1px solid rgba(94, 255, 181, 0.52);
		border-radius: 5px;
		color: var(--green);
		background: rgba(94, 255, 181, 0.08);
		box-shadow: inset 0 0 18px rgba(94, 255, 181, 0.06);
		transition:
			background 160ms ease,
			transform 160ms ease;
	}

	.prompt-button :global(.pixel-icon) {
		--pixel-icon-size: 24px;
	}

	.prompt-button:hover {
		background: rgba(94, 255, 181, 0.16);
		transform: translateY(-1px);
	}

	@media (prefers-reduced-motion: reduce) {
		nav a,
		.prompt-button {
			transition: none;
		}
		.prompt-button:hover {
			transform: none;
		}
	}

	@media (max-width: 900px) {
		.shell-header {
			grid-template-columns: 1fr 42px;
			padding: 18px var(--section-gutter);
		}

		nav {
			grid-column: 1 / -1;
			grid-row: 2;
			justify-content: safe center;
			overflow-x: auto;
			padding-bottom: 2px;
		}
	}

	@media (max-width: 560px) {
		.shell-header {
			gap: 14px;
		}

		nav {
			gap: 18px;
		}
	}
</style>
